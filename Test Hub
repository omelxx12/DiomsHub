-- Owner Highlight Tool (Rayfield UI)
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- ===== CONFIG =====
local OWNER_IDS = {
    123456789, -- replace with your UserId(s)
}
-- ==================

local function isOwner(player)
    for _, id in ipairs(OWNER_IDS) do
        if player.UserId == id then
            return true
        end
    end
    return false
end

if not isOwner(LocalPlayer) then
    return -- non-owners never see the UI
end

local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
    Name = "Owner Tools",
    LoadingTitle = "Owner Tools",
    LoadingSubtitle = "Player Highlighter",
    ConfigurationSaving = { Enabled = false },
})

local Tab = Window:CreateTab("Highlights", nil)

local activeHighlights = {}

local function addHighlight(player, color)
    if not player.Character then return end
    if activeHighlights[player] then
        activeHighlights[player]:Destroy()
    end
    local h = Instance.new("Highlight")
    h.FillColor = color
    h.OutlineColor = Color3.new(1, 1, 1)
    h.FillTransparency = 0.5
    h.OutlineTransparency = 0
    h.Adornee = player.Character
    h.Parent = player.Character
    activeHighlights[player] = h
end

local function removeHighlight(player)
    if activeHighlights[player] then
        activeHighlights[player]:Destroy()
        activeHighlights[player] = nil
    end
end
