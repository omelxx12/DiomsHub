-- =========================
-- INFINITE JUMP
-- =========================

local infJumpButton = Instance.new("TextButton")
infJumpButton.Size = UDim2.new(1, 0, 0, 40)
infJumpButton.BackgroundColor3 = Color3.fromRGB(55, 55, 65)
infJumpButton.TextColor3 = Color3.new(1, 1, 1)
