-- Owner Highlight Tool (Rayfield UI)
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- ===== CONFIG =====
local OWNER_IDS = {
    11387658482, -- replace with your UserId(s)
}
-- ==================

local function isOwner(player)
    for _, id in ipairs(OWNER_IDS) do
        if player.UserId == id then
            return true
        end
    end
    return false
end

if not isOwner(LocalPlayer) then
    return -- non-owners never see the UI
end

local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
    Name = "Owner Tools",
    LoadingTitle = "Owner Tools",
    LoadingSubtitle = "Player Highlighter",
    ConfigurationSaving = { Enabled = false },
})

local Tab = Window:CreateTab("Highlights", nil)

local activeHighlights = {}

local function addHighlight(player, color)
    if not player.Character then return end
    if activeHighlights[player] then
        activeHighlights[player]:Destroy()
    end
    local h = Instance.new("Highlight")
    h.FillColor = color
    h.OutlineColor = Color3.new(1, 1, 1)
    h.FillTransparency = 0.5
    h.OutlineTransparency = 0
    h.Adornee = player.Character
    h.Parent = player.Character
    activeHighlights[player] = h
end

local function removeHighlight(player)
    if activeHighlights[player] then
        activeHighlights[player]:Destroy()
        activeHighlights[player] = nil
    end
end

-- Toggle: highlight ALL players (e.g. to watch everyone at once during an egg-steal round)
Tab:CreateToggle({
    Name = "Highlight All Players",
    CurrentValue = false,
    Flag = "HighlightAll",
    Callback = function(Value)
        if Value then
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer then
                    addHighlight(plr, Color3.fromRGB(255, 0, 0))
                end
            end
        else
            for plr, _ in pairs(activeHighlights) do
                removeHighlight(plr)
            end
        end
    end,
})

-- Dropdown to pick one player
local function getPlayerNames()
    local names = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            table.insert(names, plr.Name)
        end
    end
    return names
end

local PlayerDropdown = Tab:CreateDropdown({
    Name = "Select Player",
    Options = getPlayerNames(),
    CurrentOption = {},
    Flag = "PlayerSelect",
    Callback = function(Option) end,
})

Tab:CreateButton({
    Name = "Highlight Selected (Green)",
    Callback = function()
        local selected = PlayerDropdown.CurrentOption[1]
        local plr = Players:FindFirstChild(selected or "")
        if plr then
            addHighlight(plr, Color3.fromRGB(0, 255, 0))
        end
    end,
})

Tab:CreateButton({
    Name = "Remove Selected Highlight",
    Callback = function()
        local selected = PlayerDropdown.CurrentOption[1]
        local plr = Players:FindFirstChild(selected or "")
        if plr then
            removeHighlight(plr)
        end
    end,
})

Tab:CreateButton({
    Name = "Refresh Player List",
    Callback = function()
        PlayerDropdown:Refresh(getPlayerNames())
    end,
})

Players.PlayerRemoving:Connect(function(plr)
    removeHighlight(plr)
end)

Players.PlayerAdded:Connect(function(plr)
    plr.CharacterAdded:Connect(function()
        if activeHighlights[plr] then
            task.wait(0.5)
            addHighlight(plr, Color3.fromRGB(255, 0, 0))
        end
    end)
end)
